<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thc.goornotdev.mapper.UserMapper">

    <!-- 목록 조회 공통 조건 -->
    <sql id="listWhere">
        <where>
            <choose>
                <when test="deleted != null">
                    AND u.deleted = #{deleted}
                </when>
                <otherwise>
                    AND u.deleted = false
                </otherwise>
            </choose>
            <if test="name != null and name != ''">
                AND u.name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
    </sql>

    <!-- 상세 조회. password 는 응답에 포함하지 않는다 -->
    <select id="detail" parameterType="java.lang.Long"
            resultType="com.thc.goornotdev.DTO.UserDto$DetailResDto">
        SELECT u.id,
               u.deleted,
               u.created_at,
               u.modified_at,
               u.username,
               u.name,
               u.email,
               u.phone,
               u.birth
        FROM users u
        WHERE u.id = #{id}
          AND u.deleted = false
    </select>

    <!-- 목록 조회는 id 만 조회하고 상세는 서비스에서 채운다 -->
    <select id="list" parameterType="com.thc.goornotdev.DTO.UserDto$ListReqDto"
            resultType="com.thc.goornotdev.DTO.UserDto$DetailResDto">
        SELECT u.id
        FROM users u
        <include refid="listWhere"/>
        ORDER BY u.id DESC
    </select>

</mapper>
