<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thc.goornotdev.mapper.ThrowSessionMapper">

    <!-- 목록 조회 공통 조건 -->
    <sql id="listWhere">
        <where>
            <choose>
                <when test="deleted != null">
                    AND s.deleted = #{deleted}
                </when>
                <otherwise>
                    AND s.deleted = false
                </otherwise>
            </choose>

            <!--
                소유자 조건. 서비스에서 요청자 정보로 덮어쓴 값이 들어온다.
                로그인 상태면 내 세션만, 비로그인이면 아직 주인이 없는 내 기기의 세션만 본다.
                둘 다 비어 있으면 아무것도 조회되지 않도록 막는다.
            -->
            <choose>
                <when test="userId != null">
                    AND s.user_id = #{userId}
                </when>
                <when test="deviceId != null and deviceId != ''">
                    AND s.device_id = #{deviceId}
                    AND s.user_id IS NULL
                </when>
                <otherwise>
                    AND 1 = 0
                </otherwise>
            </choose>

            <if test="source != null">
                AND s.source = #{source}
            </if>
            <if test="status != null">
                AND s.status = #{status}
            </if>
        </where>
    </sql>

    <!-- 상세 조회. 소유권 검증은 서비스에서 한다 -->
    <select id="detail" parameterType="java.lang.Long"
            resultType="com.thc.goornotdev.DTO.ThrowSessionDto$DetailResDto">
        SELECT s.id,
               s.deleted,
               s.created_at,
               s.modified_at,
               s.user_id,
               s.device_id,
               s.source,
               s.total_count,
               s.status,
               s.region_code,
               s.region_name,
               s.lat,
               s.lng
        FROM throw_session s
        WHERE s.id = #{id}
          AND s.deleted = false
    </select>

    <!-- 목록 조회는 id 만 조회하고 상세는 서비스에서 채운다 -->
    <select id="list" parameterType="com.thc.goornotdev.DTO.ThrowSessionDto$ListReqDto"
            resultType="com.thc.goornotdev.DTO.ThrowSessionDto$DetailResDto">
        SELECT s.id
        FROM throw_session s
        <include refid="listWhere"/>
        ORDER BY s.id DESC
    </select>

</mapper>
